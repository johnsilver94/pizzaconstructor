<div class="products">
<% for (var i = 0; i < products.length; i++) { %>
<form class="pizza-tile">
  <a href="https://www.w3schools.com">
  <div class="tile-header" style="background-image:url('https://i.postimg.cc/44b1D01y/Rectangle-417.png');">
    <i class="fab fa-adn">
      <p class="alergents">ALERGENTS:</p>
      <p class="alergents"><%=(products[i].alergents || []).map(e => e.name).join(" ,") %></p>
    </i>
  </div>
  </a>
  <div class="tile-body">
      <h3><%=products[i].name %></h3>
      <p class="description"><%=(products[i].ingredients || []).map(e => e.name).join(" ,") %></p>

     <h4>Size</h4>
    <div class="size">
      <% if (products[i].size_price && products[i].size_price.length > 0) { %>
        <% for (var s = 0; s < products[i].size_price.length; s++) { %>
        <div>
          <input type="radio" name="size" id="i-size-<%=i%>-<%=s%>" value="<%=products[i].size_price[s].size%>" <%= s === 0 ? 'checked' : '' %>>
          <label for="i-size-<%=i%>-<%=s%>">
            <p><%=products[i].size_price[s].size %></p>
            <i><%=products[i].size_price[s].price %></i>
          </label>
        </div>
        <% } %>
      <% } %>
    </div>
       

    <div class="price-qty">
      <div class="price">
        <h4>Price</h4>
        <p><%= (products[i].size_price && products[i].size_price[0]) ? products[i].size_price[0].price : 0 %></p>
      </div>
      <div class="qty">
        <h4>Qty</h4>
        <input type="number" name="qty" min="1" max="100" step="1" value="1">
      </div>
    </div>

    
    <button class="add-product" >
      <i class="fas fa-angle-down"></i>
      Add to basket
      <span class="total"></span>
      </button>
        </div>
</form>
<% } %>
</div>